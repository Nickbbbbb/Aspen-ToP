DYNAMICS
    DYNAMICS RESULTS=ON

IN-UNITS SI SHORT-LENGTH=MM

DEF-STREAMS CONVEN ALL

MODEL-OPTION

DATABANKS 'APV140 PURE40' / 'APV140 AQUEOUS' / 'APV140 SOLIDS' &
         / 'APV140 INORGANIC' / NOASPENPCD

PROP-SOURCES 'APV140 PURE40' / 'APV140 AQUEOUS' /  &
        'APV140 SOLIDS' / 'APV140 INORGANIC'

COMPONENTS
    ETHYL-01 C2H4 /
    ETHAN-01 C2H6

SOLVE
    RUN-MODE MODE=SIM

FLOWSHEET
    BLOCK COL IN=FEED OUT=S1 S2

PROPERTIES SRK

STREAM FEED
    SUBSTREAM MIXED TEMP=280. PRES=1013250.  &
        MOLE-FLOW=1000. <MOL/SEC>
    MOLE-FRAC ETHYL-01 0.5 / ETHAN-01 0.5

BLOCK COL RADFRAC
    PARAM NSTAGE=20 ALGORITHM=STANDARD MAXOL=25 DAMPING=NONE
    PARAM2
    COL-CONFIG CONDENSER=PARTIAL-V-L
    FEEDS FEED 10
    PRODUCTS S1 1 V / S2 20 L / S4 1 L
    P-SPEC 1 1013250. / 2 1013250.
    COL-SPECS DP-STAGE=0. MOLE-RDV=0.5 MASS-D=0.1665 MOLE-RR=2.

EO-CONV-OPTI

STREAM-REPOR MOLEFLOW
;
