DYNAMICS
    DYNAMICS RESULTS=ON

IN-UNITS SI SHORT-LENGTH=MM

DEF-STREAMS CONVEN ALL

DATABANKS 'APV140 PURE40' / 'APV140 AQUEOUS' / 'APV140 SOLIDS' &
         / 'APV140 INORGANIC' / NOASPENPCD

PROP-SOURCES 'APV140 PURE40' / 'APV140 AQUEOUS' /  &
        'APV140 SOLIDS' / 'APV140 INORGANIC'

COMPONENTS
    N-BUT-01 C4H10-1 /
    WATER H2O

SOLVE
    RUN-MODE MODE=SIM

FLOWSHEET
    BLOCK MIXER IN=FEED RECYCLE OUT=S1
    BLOCK FLASH IN=S1 OUT=SINKV S2
    BLOCK SPLITTER IN=S2 OUT=SINKL S3
    BLOCK PUMP IN=S3 OUT=RECYCLE

PROPERTIES SRK

STREAM FEED
    SUBSTREAM MIXED TEMP=320.0 PRES=500000.0 MOLE-FLOW=0.1
    MOLE-FRAC N-BUT-01 .80 / WATER .20

STREAM RECYCLE
    SUBSTREAM MIXED TEMP=310.0 PRES=1000000.0 MOLE-FLOW=0.05
    MOLE-FRAC N-BUT-01 .80 / WATER .20

BLOCK MIXER MIXER
    PARAM PRES=500000.0

BLOCK FLASH FLASH2
    PARAM TEMP=310.0 PRES=300000.0

BLOCK PUMP PUMP
    PARAM PRES=1000000.0 EFF=.75

BLOCK SPLITTER SSPLIT
    FRAC MIXED SINKL 0.5

EO-CONV-OPTI

TEAR
    TEAR RECYCLE

STREAM-REPOR MOLEFLOW
