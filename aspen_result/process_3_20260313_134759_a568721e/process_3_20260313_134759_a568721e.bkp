ASPEN "40.0" DATETIME "01/07/2026 17:18:06:99" MACHINE "WIN-X64" SITEID "" USER "Administrator"
? SETUP GLOBAL ? 
\ IN-UNITS INSET = SI \
? %M FLOWSHEET GLOBAL ?
\ BLOCK BLKID = MIXER IN = (FEED X RECYCLE X) OUT = (S1 X) \ 
\ BLOCK BLKID = FLASH IN = (S1 X) OUT = (SINKV X S2 X) \ 
\ BLOCK BLKID = SPLITTER IN = (S2 X) OUT = (SINKL X S3 X) \ 
\ BLOCK BLKID = PUMP IN = (S3 X) OUT = (RECYCLE X) \ 
? COMPONENTS MAIN ? 
\ COMPONENTS CID = N-BUT-01 ANAME = "C4H10-1" / CID = WATER ANAME = "H2O" \
? %M PROPERTIES MAIN ? 
\ GPROPERTIES GOPSETNAME = SRK \ 
? %M DATABANKS ? 
\ DATABANKS FILE-SYM-NAM = ( "APV140 PURE40" "APV140 AQUEOUS" "APV140 SOLIDS" "APV140 INORGANIC" NOASPENP ) \
? SETUP GLOBAL ? 
\ STREAM-CLASS SCLASS = CONVEN \ 
? STREAM MATERIAL FEED ?
\ SUBSTREAM SSID = MIXED TEMP = 320.0 <22> <1> PRES = 500000.0 <20> <1> FLOWBASE = MOLE TOTFLOW = 0.1 <-89> <1> BASIS = MOLE-FRAC \
\ MOLE-FLOW SSID1 = MIXED CID = N-BUT-01 FLOW = .80 <-4> <0> \
\ MOLE-FLOW SSID1 = MIXED CID = WATER FLOW = .20 <-4> <0> \

? STREAM MATERIAL RECYCLE ?
\ SUBSTREAM SSID = MIXED TEMP = 310.0 <22> <1> PRES = 1000000.0 <20> <1> FLOWBASE = MOLE TOTFLOW = 0.05 <-89> <1> BASIS = MOLE-FRAC \
\ MOLE-FLOW SSID1 = MIXED CID = N-BUT-01 FLOW = .80 <-4> <0> \
\ MOLE-FLOW SSID1 = MIXED CID = WATER FLOW = .20 <-4> <0> \

? BLOCK MIXER MIXER ? 
\ PARAM PRES = 500000.0 <20> <1> \
? BLOCK FLASH2 FLASH ? 
\ PARAM TEMP = 310.0 <22> <1> PRES = 300000.0 <20> <1> \ 
? BLOCK SSPLIT SPLITTER ? 
\ PARAM SID = SINKL SUBSTREAM = MIXED FRAC = .50 <0> <0> \
? BLOCK PUMP PUMP ? 
\ PARAM PRES = 1000000.0 <20> <1> EFF = .75 <0> <0> OPT-SPEC = PRES \
? TEAR ?
\ TEAR SID = RECYCLE \ ? SOLVE ? 
\ RUN-MODE MODE = SIM \ ? REPORT STREAM-REPOR ? 
\ OPTIONS MOLEFLOW = MOLEFLOW \ "\@" 