"COMP-LIST" GLOBAL ? ? SOLVE ? \ "RUN-MODE" MODE = SIM \ ? "DYN-OPTIONS" ? ? 
FLOWSHEET GLOBAL ? \ BLOCK BLKID = COMP BLKTYPE = "COMPR" MDLTYPE = "Compr" 
IN = ( FEED M0-1 ) OUT = ( S1 M0-1 ) \ \ BLOCK BLKID = COOLER BLKTYPE = 
"HEATER" MDLTYPE = "Heater" IN = ( S1 M0-1 ) OUT = ( PROD M0-1 ) \ \ 
"DEF-STREAM" SCLASS = "CONVEN" \ ? PROPERTIES MAIN ? \ GPROPERTIES GBASEOPSET
 = SRK GOPSETNAME = SRK PARCON = -2 \ ? PROPERTIES "OPTION-SETS" SRK ? \ 
PARAM BASE = SRK \ ? PROPERTIES "MOLEC-STRUCT" "ETHAN-01" ? ? PROPERTIES 
"MOLEC-STRUCT" "METHA-01" ? ? PROPERTIES PARAMETERS BINARY SCALAR "MLQKIJ-1" 
? ; "SI_MOLE" ; \ PROP-LIST PARAMNAME = MLQKIJ SETNO = 1 \ ? PROPERTIES 
PARAMETERS BINARY SCALAR "RKTKIJ-1" ? ; "SI_MOLE" ; \ PROP-LIST PARAMNAME = 
RKTKIJ SETNO = 1 \ ? PROPERTIES PARAMETERS BINARY "T-DEPENDENT" "ANDKIJ-1" ? 
; "SI_MOLE" ; \ PROP-LIST PARAMNAME = ANDKIJ SETNO = 1 UNITROW = 0 TUNITROW
 = 22 TUNITLABEL = F NEL = 2 \ ? PROPERTIES PARAMETERS BINARY "T-DEPENDENT" 
"ANDMIJ-1" ? ; "SI_MOLE" ; \ PROP-LIST PARAMNAME = ANDMIJ SETNO = 1 UNITROW
 = 0 TUNITROW = 22 TUNITLABEL = F NEL = 2 \ ? PROPERTIES PARAMETERS BINARY 
"T-DEPENDENT" "MUKIJ-1" ? ; "SI_MOLE" ; \ PROP-LIST PARAMNAME = MUKIJ SETNO
 = 1 UNITROW = 0 TUNITROW = 22 TUNITLABEL = F NEL = 6 \ ? PROPERTIES 
PARAMETERS BINARY "T-DEPENDENT" "MULIJ-1" ? ; "SI_MOLE" ; \ PROP-LIST 
PARAMNAME = MULIJ SETNO = 1 UNITROW = 0 TUNITROW = 22 TUNITLABEL = F NEL = 11 
\ ? PROPERTIES PARAMETERS BINARY "T-DEPENDENT" "SRKKIJ-1" ? ; "SI_MOLE" ; \ 
PROP-LIST PARAMNAME = SRKKIJ SETNO = 1 UNITROW = 0 TUNITROW = 22 TUNITLABEL
 = F NEL = 5 \ ? PROPERTIES PARAMETERS BINARY "T-DEPENDENT" "SRKLIJ-1" ? ; 
"SI_MOLE" ; \ PROP-LIST PARAMNAME = SRKLIJ SETNO = 1 UNITROW = 0 TUNITROW = 22 
TUNITLABEL = F NEL = 8 \ ? "STREAM-GROUP" All ? \ DESCRIPTION DESCRIPTION = 
"所有流股" \ ? "STREAM-GROUP" Boundary ? \ DESCRIPTION DESCRIPTION = "边界流股" 
\ ? "STREAM-GROUP" Charge ? \ DESCRIPTION DESCRIPTION = "进料流股" \ ? 
"STREAM-GROUP" Feeds ? \ DESCRIPTION DESCRIPTION = "进料流股" \ ? 
"STREAM-GROUP" Initial ? \ DESCRIPTION DESCRIPTION = "用户指定输入值的流股" 
\ ? "STREAM-GROUP" Products ? \ DESCRIPTION DESCRIPTION = "产品流股" \ ? 
"STREAM-GROUP" Tears ? \ DESCRIPTION DESCRIPTION = "被收敛算法控制的撕裂流股" 
\ ? STREAM MATERIAL FEED ? ; "SI_MOLE" ; \ SUBSTREAM SSID = MIXED TEMP = 300. 
<22> <1> PRES = 101325. <20> <1> BASIS = "MOLE-FRAC" FLOWBASE = MOLE TOTFLOW
 = 0.05 <-89> <1> MIXED-SPEC = TP TOTAL = 1. <-4> <0> JUNK = 2 \ \ MOLE-FLOW 
SSID1 = MIXED CID = "METHA-01" FLOW = 0.4 <-4> <0> /  SSID1 = MIXED CID = 
"ETHAN-01" FLOW = 0.6 <-4> <0> \ ? "EO-VARS" ? ? BLOCK HEATER COOLER ? ; 
"SI_MOLE" ; \ PARAM TEMP = 300. <22> <1> PRES = 0. <20> <1> DPPARMOPT = NO 
