TOTFLOW = 0.1 <-89> <1> MIXED-SPEC = TP TOTAL = 1. <-4> <0> JUNK = 3 \ \ 
MOLE-FLOW SSID1 = MIXED CID = "ETHAN-01" FLOW = 0.5 <-4> <0> /  SSID1 = MIXED 
