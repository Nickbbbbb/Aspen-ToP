HEATER
? SETUP MAIN ? \ SIMULATE INTERACTIVE = NO MOLEFLOW = MOLEFLOW \ ? SETUP 
GLOBAL ? \ "IN-UNITS" INSET = SI \ \ "STREAM-CLASS" SCLASS = CONVEN \ ? SETUP 
DIAGNOSTICS ? ? SETUP "SIM-OPTIONS" ? ; "SI_MOLE" ; ? SETUP "MODEL-OPTION" ? 
; "SI_MOLE" ; ? SETUP "RUN-CONTROL" ? ? DATABANKS ? \ DATABANKS FILE-SYM-NAM
 = ( "APV140 PURE40" "APV140 AQUEOUS" "APV140 SOLIDS" "APV140 INORGANIC" ) 
\ ? COMPONENTS MAIN ? \ COMPONENTS CID = "ETHAN-01" ANAME = C2H6 OUTNAME = 
"ETHAN-01" DBNAME1 = "ETHANE" ANAME1 = "C2H6" /  CID = "PROPA-01" ANAME = 
C3H8 OUTNAME = "PROPA-01" DBNAME1 = "PROPANE" ANAME1 = "C3H8" \ ? COMPONENTS 
"COMP-LIST" GLOBAL ? ? SOLVE ? \ "RUN-MODE" MODE = SIM \ ? "DYN-OPTIONS" ? ? 
FLOWSHEET GLOBAL ? \ BLOCK BLKID = HEATER BLKTYPE = "HEATER" MDLTYPE = "Heater" 
IN = ( FEED M0-1 ) OUT = ( SINK M0-1 ) \ \ "DEF-STREAM" SCLASS = "CONVEN" \ ? 
